# PiPanda Camera Module 3 capture settings.
# This file is sourced by /usr/local/libexec/pipanda-camera-source.

WIDTH=1920
HEIGHT=1080
FRAMERATE=30
BITRATE=4000000
AUTOFOCUS_MODE=continuous

# Sensor crop: x,y,width,height as fractions of the full, unflipped frame.
# Includes the marked print area with a little extra left margin for 16:9.
# Output stays 1920x1080; use 0,0,1,1 to restore the full field of view.
ROI=0.108,0.108,0.892,0.892

# Set both to 1 when the camera is mounted upside down.
HORIZONTAL_FLIP=0
VERTICAL_FLIP=0
