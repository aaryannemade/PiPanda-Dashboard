[Unit]
Description=PiPanda dashboard backend
Documentation=https://github.com/aaryannemade/pipanda-dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=pipanda
WorkingDirectory=/var/lib/pipanda
# Use the writable StateDirectory as the working directory. A relative path
# avoids systemd DynamicUser's /var/lib/pipanda -> private/pipanda symlink when
# the credentials store ensures its directory exists.
Environment=PIPANDA_STATE_DIR=.
EnvironmentFile=-/etc/pipanda/pipanda.env
ExecStart=/usr/local/bin/pipanda serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
