[Unit]
Description=PiPanda Camera WebRTC service
Documentation=https://github.com/AlexxIT/go2rtc
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=video render
StateDirectory=pipanda-camera
WorkingDirectory=/var/lib/pipanda-camera
Environment=LIBCAMERA_LOG_LEVELS=*:WARN
ExecStart=/usr/local/bin/go2rtc -config /etc/pipanda/go2rtc.yaml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# The camera and WebRTC need device and network access, but not privilege or
# access to user homes.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
