#!/bin/bash
# Provision into private staging first; never replace working keys on a failed
# network request. Match credentials.json ownership for systemd DynamicUser.
set -euo pipefail
umask 077

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="/var/lib/pipanda"
RESTART=0

usage() {
  cat <<'EOF'
Usage: sudo pipanda-signing-refresh [--restart] [--state-dir PATH]

Fetch current Bambu command-signing credentials using the saved Bambu login.
Existing credentials are preserved if provisioning or verification fails.

Options:
  --restart         restart pipanda.service after successful refresh
  --state-dir PATH  override /var/lib/pipanda (must be an absolute path)
  -h, --help        show this help

Without --restart, restart the backend manually to load the new keys.
Node.js 18+ is required only during refresh; no Nix or Bun is needed on the Pi.
EOF
}

while (($#)); do
  case "$1" in
    --restart) RESTART=1; shift ;;
    --state-dir)
      [[ $# -ge 2 && "$2" == /* ]] || { echo "--state-dir requires an absolute path" >&2; exit 2; }
      STATE_DIR="${2%/}"
      [[ -n "$STATE_DIR" ]] || { echo "The filesystem root is not a state directory" >&2; exit 2; }
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if (( RESTART && EUID != 0 )); then
  echo "Use sudo when requesting a service restart" >&2
  exit 1
fi

HELPER="/usr/local/share/pipanda/signing-setup.mjs"
if [[ -f "$SCRIPT_DIR/../../tools/signing-setup.mjs" ]]; then
  HELPER="$SCRIPT_DIR/../../tools/signing-setup.mjs"
fi
[[ -f "$HELPER" ]] || { echo "Signing helper missing; install the latest PiPanda release" >&2; exit 1; }
command -v node >/dev/null || { echo "Install Node.js first: sudo apt-get install nodejs" >&2; exit 1; }
command -v flock >/dev/null || { echo "Install util-linux for flock" >&2; exit 1; }
node -e 'if (Number(process.versions.node.split(".")[0]) < 18) process.exit(1)' || {
  echo "Node.js 18 or newer is required" >&2; exit 1;
}

[[ -r "$STATE_DIR/credentials.json" && -w "$STATE_DIR" ]] || {
  echo "Cannot access Bambu credentials in $STATE_DIR; log in through Settings first and run this command with sudo" >&2
  exit 1
}

# Serialize refreshes without stopping monitoring while network IO runs.
exec 9>"$STATE_DIR/.signing-refresh.lock"
flock -n 9 || { echo "Another signing refresh is already running" >&2; exit 1; }

staging="$(mktemp -d "$STATE_DIR/.signing-refresh.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
install -m 0600 "$STATE_DIR/credentials.json" "$staging/credentials.json"
PIPANDA_STATE_DIR="$staging" node "$HELPER"

files=(slicer_cert.pem slicer_crl.pem slicer_cert_id.txt slicer_key.pem)
# Prepare every file before replacing any; root must preserve DynamicUser's
# ownership rather than leave root-owned signing files unreadable by pipanda.
for name in "${files[@]}"; do
  [[ -s "$staging/$name" ]] || { echo "Signing setup omitted $name; existing keys were not changed" >&2; exit 1; }
  chmod 0600 "$staging/$name"
  chown --reference="$STATE_DIR/credentials.json" "$staging/$name"
done
for name in "${files[@]}"; do
  mv -fT -- "$staging/$name" "$STATE_DIR/$name"
done

echo "Signing credentials refreshed in $STATE_DIR."
if (( RESTART )); then
  systemctl restart pipanda.service
  echo "PiPanda restarted with the new signing credentials."
else
  echo "Activate them with: sudo systemctl restart pipanda.service"
fi
